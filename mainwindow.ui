                 <item row="3" column="0" colspan="2">
                  <widget class="QCheckBox" name="cbEveryPhoto">
                   <property name="toolTip">
                    <string>Every photo of the folder or selection appears at least once, e.g. for a wedding or a yearbook. Each photo first gets the free cell it fits best, then the remaining cells are filled as usual. Works best with many more cells than photos; Tint helps photos that fit nowhere blend in. With more photos than cells, every photo is used at most once instead.</string>
                   </property>
                   <property name="text">
                    <string>Use every photo at least once</string>
                   </property>
                  </widget>
                 </item>
